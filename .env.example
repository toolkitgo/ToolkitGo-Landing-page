# Google Sheets Webhook Integration
# Deploy scripts/google-sheets-apps-script.js after running configureSpreadsheet in the editor.
# Use Execute as Me / access Anyone; paste the deployed URL ending in /exec (not /dev).
# Production hosting needs this server-side variable too; restart/redeploy after changing it.
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbx_EXAMPLE_WEBHOOK_ID/exec"
